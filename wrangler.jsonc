{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "giftos",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node scripts/embed.mjs", "watch_dir": "public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "giftos",
      "database_id": "cac192c1-c4e9-459f-9a6b-8c9f81218030",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
